# Example environment variables for Shardeum Dashboard
# Copy this file to .env and customize as needed

# Default network to connect to
VITE_DEFAULT_NETWORK=local

# Custom network endpoints (optional)
# VITE_LOCAL_RPC_ENDPOINT=http://localhost:26658
# VITE_LOCAL_API_ENDPOINT=http://localhost:1318
# VITE_LOCAL_JSONRPC_ENDPOINT=http://localhost:8547