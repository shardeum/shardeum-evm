                        <div class="code-block">
<pre><code class="language-go">// BondedRatio the current fraction of the staking token which is currently bonded
func (k Keeper) BondedRatio(ctx context.Context) (math.LegacyDec, error) {
    bondedTokens, err := k.StakingTokenSupply(ctx)
    if err != nil {
        return math.LegacyZeroDec(), err
    }

    totalSupply := k.TokenSupply(ctx)
    if totalSupply.IsZero() {
        return math.LegacyZeroDec(), nil
    }

    return math.LegacyNewDecFromInt(bondedTokens).QuoInt(totalSupply), nil
}</code></pre>
                        </div>

