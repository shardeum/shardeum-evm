    <script>
        // Load Prism.js with proper error handling
        function loadPrism() {
            const coreScript = document.createElement('script');
            coreScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js';
            coreScript.onload = function() {
                const goScript = document.createElement('script');
                goScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-go.min.js';
                goScript.onload = function() {
                    if (typeof Prism !== 'undefined') {
                        Prism.highlightAll();
                    }
                };
                goScript.onerror = function() {
                    console.warn('Failed to load Prism Go component');
                };
                document.head.appendChild(goScript);
            };
            coreScript.onerror = function() {
                console.warn('Failed to load Prism core');
            };
            document.head.appendChild(coreScript);
        }
        
        // Load Prism after DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', loadPrism);
        } else {
            loadPrism();
        }
    </script>
