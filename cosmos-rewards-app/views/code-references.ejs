                        <h5>📁 File: <code>cosmos-sdk/x/mint/types/minter.go</code></h5>
                        <div class="code-block">
<pre><code class="language-go">// NextInflationRate returns the new inflation rate for the next hour.
func (m Minter) NextInflationRate(params Params, bondedRatio math.LegacyDec) math.LegacyDec {
    // Get parameters from your genesis.json
    inflationRateChangePerYear := params.InflationRateChange  // 0.13 (13%)
    inflationMin := params.InflationMin                       // 0.07 (7%)
    inflationMax := params.InflationMax                       // 0.20 (20%)
    bondedRatioTarget := params.GoalBonded                    // 0.67 (67%)

    if bondedRatio.LT(bondedRatioTarget) {
        // UNDER-STAKED: Increase inflation to attract more stakers
        inflationRate := m.Inflation.Add(
            inflationRateChangePerYear.Mul(
                bondedRatioTarget.Sub(bondedRatio)
            ).Quo(math.LegacyNewDec(int64(params.BlocksPerYear)))  // KEY: Divide by blocks per year
        )

        // Cap at maximum inflation
        if inflationRate.GT(inflationMax) {
            inflationRate = inflationMax
        }
        return inflationRate

    } else {
        // OVER-STAKED: Decrease inflation to encourage unstaking
        inflationRate := m.Inflation.Sub(
            inflationRateChangePerYear.Mul(
                bondedRatio.Sub(bondedRatioTarget)
            ).Quo(math.LegacyNewDec(int64(params.BlocksPerYear)))
        )

        // Cap at minimum inflation
        if inflationRate.LT(inflationMin) {
            inflationRate = inflationMin
        }
        return inflationRate
    }
}</code></pre>
